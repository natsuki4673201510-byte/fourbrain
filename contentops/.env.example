# コピーして .env を作成（.env は git 管理外・chmod 600 推奨）
# 値はソースコードに書かないこと。未使用のものは空のままでOK。

# Phase 2以降: Anthropic API を直接使う場合のみ（通常は Claude Code CLI を使うため不要）
ANTHROPIC_API_KEY=

# Phase 4: X API（公式API / OAuth 2.0 ユーザーコンテキスト）
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=

# Phase 5: 販売プラットフォーム（決定後に設定）
GUMROAD_ACCESS_TOKEN=
LEMONSQUEEZY_API_KEY=
PAYHIP_API_KEY=

# 任意: データ保存先（既定: contentops/data）
# COPS_DATA_DIR=
# 管理画面ポート（既定: 8765）
# COPS_PORT=
